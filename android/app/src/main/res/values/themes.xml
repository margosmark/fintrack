<?xml version="1.0" encoding="utf-8"?>
<!-- Compose owns all in-app styling; this theme only keeps the launch window
     sane before the first frame (light default, matches paper background). -->
<resources>
    <style name="Theme.FinTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background_light</item>
    </style>
</resources>
