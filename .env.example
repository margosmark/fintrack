DATABASE_URL=postgresql+psycopg://fintrack:fintrack@localhost:5432/fintrack
# Postgres password used by the compose `db` service AND embedded in
# DATABASE_URL above (both read this one key). Dev default shown; the
# deployed .env MUST set a random value: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=fintrack
# Row-level security (docs/55): the UNPRIVILEGED role the request path
# connects as. Unset (default) = requests share DATABASE_URL's schema owner
# and the tenant policies are inert (the pre-RLS behaviour). To arm the
# second lock: create the role (`cd backend && uv run python
# scripts/provision_rls_role.py`), deploy (alembic applies the per-database
# grants), then set this key and restart the api — boot must log
# "Request role ... verified". The password is APP_ROLE_PASSWORD when set,
# else the one inside this URL (keep them in step).
# APP_DATABASE_URL=postgresql+psycopg://fintrack_app:fintrack@localhost:5432/fintrack
JWT_SECRET=change-me-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# --- JWT signing-key separation + dedicated secrets-encryption key ------------
# Server-signed JWTs (access / 2FA-challenge / OIDC hand-off) are RS256 with a
# `kid`, split across TWO key families so one leaked key cannot mint every kind
# of token (docs/38 §Key separation). JWT_SECRET no longer signs any JWT — it is
# kept only as the legacy Fernet fallback below and the webhook-HMAC fallback.
#
# Provision the two keypairs + a Fernet key with:
#   cd backend && uv run python scripts/generate_jwt_keys.py --out ../secrets
# (the ../secrets dir is the one docker-compose.yml mounts READ-ONLY into the
# api container at /run/secrets/jwt), then paste the *_KEY_PATH lines +
# APP_ENCRYPTION_KEY it prints — with the paths REWRITTEN to the
# container-visible form below, because the api process only sees files under
# the mount (a host path like /home/developer/... does not exist in the
# container; _load_family then hard-fails rather than silently signing with a
# fresh key):
#   JWT_ACCESS_PRIVATE_KEY_PATH=/run/secrets/jwt/jwt_access_private.pem
#   JWT_ACCESS_PUBLIC_KEY_PATH=/run/secrets/jwt/jwt_access_public.pem
#   JWT_SESSION_PRIVATE_KEY_PATH=/run/secrets/jwt/jwt_session_private.pem
#   JWT_SESSION_PUBLIC_KEY_PATH=/run/secrets/jwt/jwt_session_public.pem
# Leave the four paths EMPTY and the API generates an ephemeral in-process
# keypair — fine for dev/tests, but tokens then do NOT survive a restart or a
# second worker, so a deployment MUST set them. Keep the *.pem files private
# (gitignored, never commit a private key). Provision the keys BEFORE the next
# `docker compose up -d`, or mkdir secrets first — compose auto-creates a
# missing bind dir root-owned, which the generator (as your user) cannot write.
JWT_ACCESS_PRIVATE_KEY_PATH=
JWT_ACCESS_PUBLIC_KEY_PATH=
JWT_ACCESS_KID=access-1
JWT_SESSION_PRIVATE_KEY_PATH=
JWT_SESSION_PUBLIC_KEY_PATH=
JWT_SESSION_KID=session-1
# Fernet key (urlsafe-b64, 32 raw bytes) encrypting user secrets at rest
# (TOTP seeds + llm_api_key). EMPTY = legacy sha256(JWT_SECRET) derivation (so
# an existing install keeps decrypting with no migration). SETTING IT decouples
# at-rest encryption from token signing: rotating JWT_SECRET then no longer
# orphans stored TOTP seeds / LLM keys. Safe to set on an EXISTING install
# with zero migration: decrypt_secret tries primary -> APP_ENCRYPTION_KEY_FALLBACKS
# -> legacy sha256(JWT_SECRET), so every existing ciphertext stays readable
# the moment the key is set; new writes use the primary. Back it up WITH the
# database — losing it makes those ciphertexts unreadable. Rotating it? Put
# the OLD key(s) in APP_ENCRYPTION_KEY_FALLBACKS (comma-separated) so existing
# ciphertext stays decryptable; new writes always use the primary.
#   generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_FALLBACKS=
# Mark session cookies `Secure` (security review M2). Default in code is true;
# production is HTTPS-only. Only set false for plain-HTTP LAN-IP access.
COOKIE_SECURE=true
# Comma-separated browser origins the API accepts on CORS preflight.
# Dev default below (the Vite dev server). The DEPLOYED .env must list the
# real origin and ONLY the real origin (M87 / M83 F-8) — a prod box that still
# carries the dev value answers 400 to the site's own cross-origin preflight
# while happily allowing http://localhost:5173:
#   CORS_ORIGINS=https://fintrac.princessandmark.com
# A dev box serving both may list both (order is irrelevant):
#   CORS_ORIGINS=http://localhost:5173,https://fintrac.princessandmark.com
CORS_ORIGINS=http://localhost:5173
# M87 (docs/42): `/docs`, `/redoc` and `/openapi.json` are authenticated-only
# by default (401 {detail, code} without a session access token or a live MCP
# token). Local dev wants them OPEN — keep `true` here, and leave the key
# unset (or false) in production so it fails closed.
API_DOCS_PUBLIC=true
# docs/42: Host-header allowlist for the API listener. EMPTY = the check is OFF,
# which is the default on purpose — a wrong allowlist answers 400 to every
# request (healthcheck included), so it must never be enabled implicitly. Set it
# on a box whose listener is reachable directly (no host firewall), e.g.:
#   ALLOWED_HOSTS=localhost,api.example.com
# Behind the front nginx proxy this is defence-in-depth only: no route builds a
# URL from the Host header except the OIDC/app-origin redirects, which derive
# from settings.
ALLOWED_HOSTS=
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct
# Allow USER-supplied llm_base_url targets on RFC1918/link-local networks
# (LAN Ollama). Default false (security review H1). The operator-configured
# LLM_BASE_URL above is trusted and always allowed.
LLM_ALLOW_PRIVATE_HOSTS=false
REPORTING_CURRENCY=CAD
# M137 P1-1 (docs/33 §Server-first computing, docs/08 §Report routes): retire
# the FOUR /reports/* routes no UI surface ever consumed — /dividends,
# /cashflow-sankey, /total-return, /networth-snapshot. false (default) = they
# keep answering; true = each answers 410 report_route_deprecated with a body
# naming it. The seven report routes the screens use are never affected.
SERVER_REPORTS_DEPRECATED=false
# Demo experience: seed the one-click demo account at startup (true/false) and
# its login password. Demo user is demo@fintracker.local. Set false outside dev.
SEED_DEMO_ACCOUNT=true
DEMO_PASSWORD=demo-password
# MCP server: shared secret for internal auth (mcp server → backend API).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MCP_INTERNAL_SECRET=
# --- Notification delivery (M59, docs/37) -----------------------------------
# SMTP relay for the `email` notification channel. An EMPTY host is a fully
# supported state: the channel simply cannot be enabled (409 channel_not_configured).
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_STARTTLS=true
NOTIFY_SMTP_FROM=
# HMAC master key for webhook bodies (per-user keys are derived from it).
# Empty falls back to JWT_SECRET — note that rotating JWT_SECRET then also
# invalidates webhook keys already handed to receivers.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
NOTIFY_WEBHOOK_SECRET=
# Base for the link in the notification email.
NOTIFY_APP_BASE_URL=http://localhost:5173
# SSRF policy for USER-supplied webhook targets: loopback is always allowed;
# RFC1918/link-local/etc. need this operator opt-in.
NOTIFY_WEBHOOK_ALLOW_PRIVATE=false
# In-process delivery worker (one asyncio tick per interval).
NOTIFY_WORKER_ENABLED=true
NOTIFY_WORKER_INTERVAL_SECONDS=60
# Persistent dividend-history refresh worker (M184); pending jobs resume on startup.
DIVIDEND_REFRESH_ENABLED=true
# Scheduled price refresh (M187, docs/07 §Scheduled price refresh): advances
# today's closes on wall-clock ticks in America/New_York (NOT an interval —
# the schedule is anchored to the trading session). A malformed HH:MM entry is
# ignored with a warning; a schedule with no valid tick logs and retries every
# minute. Never overwrites a manual price; skips a privacy-mode owner's rows.
PRICE_REFRESH_ENABLED=true
PRICE_REFRESH_TIMES=09:35,12:00,15:00,16:15

# --- M74 auth hardening (docs/38) --------------------------------------------
# TOTP issuer label shown in authenticator apps.
TOTP_ISSUER=fin_tracker
# Public origin of the web app (scheme + host[:port], NO trailing slash).
# Pins the WebAuthn rpID (its hostname) and expected origin, and the base the
# OIDC callback redirects back to. Production MUST set the real origin
# (e.g. https://fintrac.princessandmark.com) — passkeys fail closed otherwise.
# Deliberately NOT derived from NOTIFY_APP_BASE_URL, which is unset in prod.
APP_ORIGIN=http://localhost:5173
# Optional OIDC SSO (off by default). All four values come from your provider
# (Authelia/Keycloak class): register the redirect URI
#   {APP_ORIGIN}/api/v1/auth/oidc/callback
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Empty derives {APP_ORIGIN}/api/v1/auth/oidc/callback; set it only if your
# deployment registers a different absolute URI.
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
